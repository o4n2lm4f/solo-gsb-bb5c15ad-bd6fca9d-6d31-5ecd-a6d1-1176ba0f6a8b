# HMAC key ring for capability tokens. ORDERED comma-separated `kid:secret`
# entries: the FIRST entry signs every new token, while every entry can
# verify tokens (looked up exactly by the `kid` claim written into the
# signed payload). Rotate keys without downtime by prepending the new key,
# waiting for old tokens to expire (max CAPABILITY_MAX_TTL), then removing
# the old entry.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Fresh install (one active key):
CAPABILITY_KEYRING=dev:dev-insecure-secret-change-me-0123456789
#
# Rotation example (uncomment): new key signs, old key still verifies:
# CAPABILITY_KEYRING=2026-09:NEW-SECRET-HERE,2026-06:OLD-SECRET-HERE
#
# Syntax notes: split happens on the FIRST colon, so secrets may contain
# colons; they must NOT contain commas. Startup rejects duplicate kids,
# empty secrets, empty/malformed entries.

# Verifies ONLY tokens issued before key-ring support (they carry no kid).
# Leave empty to reject kid-less tokens with 401 unknown_key. The ring is
# never probed for such tokens.
CAPABILITY_LEGACY_SECRET=

# Legacy single-key mode: still supported for upgrades, but mutually
# exclusive with CAPABILITY_KEYRING (setting both refuses to start). New
# tokens are then signed under kid "default" and the same secret also
# verifies old kid-less tokens.
# CAPABILITY_SECRET=dev-insecure-secret-change-me-0123456789

# Optional shared key required by POST /tokens/issue (header X-Issuer-Key).
# Leave empty to leave issuance unauthenticated (useful for local experiments).
CAPABILITY_ISSUER_KEY=

# Shared key required by the admin endpoints POST /tokens/revoke-subject and
# GET /tokens/revocations (header X-Admin-Key). When empty those endpoints
# are disabled and answer 503 (fail closed).
CAPABILITY_ADMIN_KEY=dev-insecure-admin-key-change-me-0123456789

# Storage locations (inside the container these are mounted volumes).
CAPABILITY_DB_PATH=/data/capabilities.db
CAPABILITY_FILES_DIR=/app/files

# Token lifetimes in seconds.
CAPABILITY_DEFAULT_TTL=300
CAPABILITY_MAX_TTL=3600
